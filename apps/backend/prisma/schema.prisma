generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     BigInt              @id @default(autoincrement())
  email                  String              @unique
  password_hash          String
  first_name             String
  last_name              String
  phone                  String
  country_name           String
  city_name              String
  street_name            String
  building_number        Int?
  apartment_house_number Int?
  floor_number           Int?
  description            String?
  created_at             DateTime            @default(now())
  updated_at             DateTime            @default(now())
  Notifications          Notification[]      @relation("UserNotifications")
  OrdersAsCustomer       Order[]             @relation("orders_as_customer")
  PaymentProofsUploaded  OrderPaymentProof[] @relation("OrderPaymentProof_User")
  RatingsAuthored        Rating[]            @relation("rating_rater")
  Worker                 Worker?

  @@index([email])
}

model Worker {
  id                 BigInt                @id
  is_professional    Boolean               @default(false)
  pickup_available   Boolean               @default(false)
  delivery_available Boolean               @default(false)
  description        String?
  image_url          String?
  is_online          Boolean               @default(true)
  max_orders_per_day Int                   @default(5)
  min_notice_minutes Int                   @default(120)
  max_items_per_wash Int                   @default(10)
  price_per_wash     Int                   @default(30)
  AIConversations    AIConversation?
  Orders             Order[]               @relation("orders_as_worker")
  RatingsReceived    Rating[]              @relation("rating_worker")
  user               User                  @relation(fields: [id], references: [id], onDelete: Cascade)
  Hours              WorkerBusinessHours[] @relation("WorkerHours")
  Services           WorkerService[]
}

model WorkerBusinessHours {
  worker_id   BigInt
  day_of_week Int
  start_hhmm  String
  end_hhmm    String
  Worker      Worker @relation("WorkerHours", fields: [worker_id], references: [id], onDelete: Cascade)

  @@id([worker_id, day_of_week, start_hhmm])
}

model ServiceCatalog {
  service_code                       String          @id
  display_name                       String
  unit                               String
  default_proximate_turnaround_hours Int?
  description                        String?
  delicate_fabric                    Boolean         @default(false)
  OrderServices                      OrderService[]
  WorkerServices                     WorkerService[]
}

model WorkerService {
  worker_id                  BigInt
  service_code               String
  is_active                  Boolean        @default(true)
  min_qty                    Decimal?
  max_qty                    Decimal?
  turnaround_proximate_hours Int?
  notes                      String?
  base_price                 Int            @default(0)
  Service                    ServiceCatalog @relation(fields: [service_code], references: [service_code])
  Worker                     Worker         @relation(fields: [worker_id], references: [id], onDelete: Cascade)

  @@id([worker_id, service_code])
}

model Order {
  id                       BigInt              @id @default(autoincrement())
  customer_user_id         BigInt
  worker_id                BigInt
  pickup_city              String
  pickup_street            String
  pickup_building          Int?
  pickup_apartment_house   Int
  pickup_floor             Int?
  delivery_city            String
  delivery_street          String
  delivery_building        Int?
  delivery_apartment_house Int
  delivery_floor           Int?
  scheduled_pickup         DateTime?
  scheduled_dropoff        DateTime?
  created_at               DateTime            @default(now())
  updated_at               DateTime            @default(now())
  amount                   Int                 @default(0)
  notes                    String?
  items_count              Int                 @default(0)
  payment_confirmed_at     DateTime?
  payment_confirmed_by     BigInt?
  payment_notes            String?
  payment_status           PaymentStatus       @default(UNPAID)
  washes_count             Int                 @default(0)
  status                   OrderStatus         @default(REQUESTED)
  payment_method           PaymentMethod       @default(CASH)
  Notifications            Notification[]      @relation("OrderNotifications")
  Customer                 User                @relation("orders_as_customer", fields: [customer_user_id], references: [id], onDelete: Cascade)
  Worker                   Worker              @relation("orders_as_worker", fields: [worker_id], references: [id])
  PaymentProofs            OrderPaymentProof[] @relation("OrderPaymentProof_Order")
  Services                 OrderService[]
  Rating                   Rating?

  @@index([customer_user_id])
  @@index([worker_id])
  @@index([status])
  @@index([created_at])
}

model AIConversation {
  id        BigInt      @id @default(autoincrement())
  worker_id BigInt      @unique
  Worker    Worker      @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([worker_id])
}

model AIMessage {
  id             BigInt         @id @default(autoincrement())
  conversationId BigInt
  role           AIMessageRole
  content        String
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Rating {
  id           BigInt        @id @default(autoincrement())
  order_id     BigInt        @unique
  rater_id     BigInt
  rated_worker BigInt
  score        Int
  comment      String?
  created_at   DateTime      @default(now())
  Order        Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)
  Worker       Worker        @relation("rating_worker", fields: [rated_worker], references: [id], onDelete: Cascade)
  Rater        User          @relation("rating_rater", fields: [rater_id], references: [id], onDelete: Cascade)
  Photos       RatingPhoto[]
}

model RatingPhoto {
  id         BigInt   @id @default(autoincrement())
  rating_id  BigInt
  is_cover   Boolean  @default(false)
  created_at DateTime @default(now())
  image_url  String
  Rating     Rating   @relation(fields: [rating_id], references: [id], onDelete: Cascade)

  @@index([rating_id])
}

model OrderPaymentProof {
  id          BigInt   @id @default(autoincrement())
  order_id    BigInt
  uploaded_by BigInt
  created_at  DateTime @default(now())
  image_url   String
  Order       Order    @relation("OrderPaymentProof_Order", fields: [order_id], references: [id], onDelete: Cascade)
  Uploader    User     @relation("OrderPaymentProof_User", fields: [uploaded_by], references: [id])

  @@index([order_id])
}

model Notification {
  id         BigInt           @id @default(autoincrement())
  user_id    BigInt
  order_id   BigInt?
  type       NotificationType
  title      String
  message    String
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())
  read_at    DateTime?
  Order      Order?           @relation("OrderNotifications", fields: [order_id], references: [id], onDelete: Cascade)
  User       User             @relation("UserNotifications", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([order_id])
  @@index([type])
  @@index([is_read])
  @@index([created_at])
}

model OrderService {
  order_id     BigInt
  service_code String
  price        Int
  Order        Order          @relation(fields: [order_id], references: [id], onDelete: Cascade)
  Service      ServiceCatalog @relation(fields: [service_code], references: [service_code])

  @@id([order_id, service_code])
}

enum OrderStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_WORKER
  CANCELLED_BY_CUSTOMER
}

enum PaymentMethod {
  CASH
  BIT
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
}

enum NotificationType {
  ORDER_RECEIVED
  ORDER_ACCEPTED
  ORDER_REJECTED
  ORDER_STATUS_UPDATED
  PAYMENT_UPDATED
  ORDER_COMPLETED
  ORDER_CANCELLED
  GENERAL
}

enum AIMessageRole {
  USER
  AI
}
