generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ========= ENUMS =========
//

enum OrderStatus {
  REQUESTED          // customer placed request
  CONFIRMED          // worker accepted
  IN_PROGRESS        // worker started washing
  COMPLETED          // delivered and finished
  CANCELLED_BY_WORKER
  CANCELLED_BY_CUSTOMER
}

enum PaymentMethod {
  CASH
  BIT
}

enum PaymentStatus {
  UNPAID               // default for new orders
  PENDING_VERIFICATION // proof uploaded, waiting for worker
  PAID                 // worker confirmed payment
}

//
// ========= MODELS =========
//

model User {
  id                     BigInt              @id @default(autoincrement())
  email                  String              @unique
  password_hash          String
  first_name             String
  last_name              String
  phone                  String
  country_name           String
  city_name              String
  street_name            String
  building_number        Int?
  apartment_house_number Int?
  floor_number           Int?
  description            String?
  created_at             DateTime            @default(now())
  updated_at             DateTime            @default(now())
  MediaAssets            MediaAsset[]
  OrdersAsCustomer       Order[]             @relation("orders_as_customer")
  RatingsAuthored        Rating[]            @relation("rating_rater")
  Worker                 Worker?
  PaymentProofsUploaded  OrderPaymentProof[] @relation("OrderPaymentProof_User")

  @@index([email])
}

model Worker {
  id                  BigInt                @id
  is_professional     Boolean               @default(false)
  pickup_available    Boolean               @default(false)
  delivery_available  Boolean               @default(false)
  description         String?
  is_online           Boolean               @default(true)
  max_orders_per_day  Int                   @default(5)
  min_notice_minutes  Int                   @default(120)

  // pricing & capacity per wash
  max_items_per_wash  Int                   @default(10)
  price_per_wash      Int                   @default(30)

  image_url           String?
  Orders              Order[]               @relation("orders_as_worker")
  RatingsReceived     Rating[]              @relation("rating_worker")
  user                User                  @relation(fields: [id], references: [id], onDelete: Cascade)
  Hours               WorkerBusinessHours[] @relation("WorkerHours")
  Services            WorkerService[]
}

model WorkerBusinessHours {
  worker_id   BigInt
  day_of_week Int
  start_hhmm  String
  end_hhmm    String
  Worker      Worker @relation("WorkerHours", fields: [worker_id], references: [id], onDelete: Cascade)

  @@id([worker_id, day_of_week, start_hhmm])
}

model ServiceCatalog {
  service_code                       String          @id
  display_name                       String
  unit                               String
  default_proximate_turnaround_hours Int?
  description                        String?
  delicate_fabric                    Boolean         @default(false)
  WorkerServices                     WorkerService[]
}

model WorkerService {
  worker_id                  BigInt
  service_code               String
  is_active                  Boolean        @default(true)
  base_price                 Int            @default(0)    // 👈 your addition
  min_qty                    Decimal?
  max_qty                    Decimal?
  turnaround_proximate_hours Int?
  notes                      String?
  Service                    ServiceCatalog @relation(fields: [service_code], references: [service_code])
  Worker                     Worker         @relation(fields: [worker_id], references: [id], onDelete: Cascade)

  @@id([worker_id, service_code])
}

model Order {
  id                       BigInt        @id @default(autoincrement())
  customer_user_id         BigInt
  worker_id                BigInt

  status                   OrderStatus   @default(REQUESTED)

  pickup_city              String
  pickup_street            String
  pickup_building          Int?
  pickup_apartment_house   Int          // 👈 required
  pickup_floor             Int?

  delivery_city            String
  delivery_street          String
  delivery_building        Int?
  delivery_apartment_house Int          // 👈 required
  delivery_floor           Int?

  scheduled_pickup         DateTime?
  scheduled_dropoff        DateTime?

  items_count              Int           @default(0)
  washes_count             Int           @default(0)

  payment_method           PaymentMethod @default(CASH)
  payment_status           PaymentStatus @default(UNPAID)
  payment_confirmed_at     DateTime?
  payment_confirmed_by     BigInt?
  payment_notes            String?

  created_at               DateTime      @default(now())
  updated_at               DateTime      @default(now())
  amount                   Int           @default(0)
  notes                    String?

  Customer                 User          @relation("orders_as_customer", fields: [customer_user_id], references: [id], onDelete: Cascade)
  Worker                   Worker        @relation("orders_as_worker", fields: [worker_id], references: [id])
  Rating                   Rating?
  PaymentProofs            OrderPaymentProof[] @relation("OrderPaymentProof_Order")
}

model MediaAsset {
  id            BigInt              @id @default(autoincrement())
  owner_user_id BigInt
  url           String
  mime_type     String
  bytes         BigInt
  width_px      Int?
  height_px     Int?
  checksum_sha1 String?
  created_at    DateTime            @default(now())
  Owner         User                @relation(fields: [owner_user_id], references: [id], onDelete: Cascade)
  Variants      MediaVariant[]
  RatingPhotos  RatingPhoto[]
  PaymentProofs OrderPaymentProof[] @relation("OrderPaymentProof_Media")
}

model MediaVariant {
  id        BigInt     @id @default(autoincrement())
  media_id  BigInt
  kind      String
  url       String
  width_px  Int?
  height_px Int?
  bytes     BigInt?
  Media     MediaAsset @relation(fields: [media_id], references: [id], onDelete: Cascade)
}

model Rating {
  id           BigInt        @id @default(autoincrement())
  order_id     BigInt        @unique
  rater_id     BigInt
  rated_worker BigInt
  score        Int
  comment      String?
  created_at   DateTime      @default(now())
  Order        Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)
  Worker       Worker        @relation("rating_worker", fields: [rated_worker], references: [id], onDelete: Cascade)
  Rater        User          @relation("rating_rater", fields: [rater_id], references: [id], onDelete: Cascade)
  Photos       RatingPhoto[]
}

model RatingPhoto {
  id        BigInt     @id @default(autoincrement())
  rating_id BigInt
  media_id  BigInt
  is_cover  Boolean    @default(false)
  Media     MediaAsset @relation(fields: [media_id], references: [id], onDelete: Cascade)
  Rating    Rating     @relation(fields: [rating_id], references: [id], onDelete: Cascade)

  @@index([rating_id])
}

model OrderPaymentProof {
  id          BigInt     @id @default(autoincrement())
  order_id    BigInt
  media_id    BigInt
  uploaded_by BigInt
  created_at  DateTime   @default(now())

  Order    Order      @relation("OrderPaymentProof_Order", fields: [order_id], references: [id], onDelete: Cascade)
  Media    MediaAsset @relation("OrderPaymentProof_Media", fields: [media_id], references: [id], onDelete: Cascade)
  Uploader User       @relation("OrderPaymentProof_User", fields: [uploaded_by], references: [id])

  @@index([order_id])
}
